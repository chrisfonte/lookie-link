# Lookie-Link Configuration
# ---------------------
# Copy this to ~/.config/lookie-link/lookie-link.yaml and customize for your setup.
# After editing, restart the server for changes to take effect.

# Markdown rendering behavior (informational — not configurable):
# - Bare URLs in markdown text (e.g. `https://example.com` in a `## Sources`
#   bullet) auto-render as clickable links via markdown-it's `linkify` option.
# - URLs inside fenced code blocks and inline `code` stay literal.
# - URLs inside HTML attribute values (e.g. `<iframe src="...">`) are not
#   touched, so embedded YouTube iframes continue to work.
# See docs/FEATURES.md#markdown-link-rendering for full details.

# Server settings
server:
  port: 9876
  hostname: localhost  # e.g., my-server.local or my-host.tailnet.ts.net
  enableEditing: false # opt-in: set true only on trusted private networks
  enableAnnotations: false # opt-in: enables sidecar annotation API routes
  enableRawHtml: false # opt-in: executes trusted authored HTML on this origin

# Repository mappings
# Each key becomes a URL prefix: /view/<key>/<path>
# Values are absolute paths or ~-relative paths to local directories.
repositories:
  docs: ~/Documents/docs
  notes: ~/notes
  # project: ~/projects/my-project

# Optional agent access control
# Secrets should normally come from env vars on the host machine.
# access:
#   humanDefault: full # full | restricted | none
#   tokens:
#     docs_reader:
#       secretEnv: LOOKIE_TOKEN_DOCS_READER
#       subject:
#         companyId: fontastic
#         agentIds: [agent-bob]
#       issuer:
#         system: paperclip
#         issueId: ACME-1234
#       audit:
#         grantId: static-phase1-docs-reader
#       repos:
#         docs:
#           paths:
#             - guides/
#             - README.md
#       permissions:
#         view: true
#         write: false
#     docs_writer:
#       secretEnv: LOOKIE_TOKEN_DOCS_WRITER
#       repos:
#         docs:
#           paths:
#             - drafts/
#       permissions:
#         view: true
#         write: true
#         publish: false
#   apiKeys:
#     storePath: ~/.local/share/lookie-link/agent-api-keys.yaml
#     adminTokens:
#       local_operator:
#         secretEnv: LOOKIE_LINK_AGENT_KEY_ADMIN_TOKEN
#   grants:
#     storePath: /srv/lookie-link/grants.yaml
#     projectionPath: /srv/lookie-link/grants-projection.yaml
#     repoOwners:
#       docs: source-company-id
#     repoRoots:
#       docs: /srv/lookie-link/repos/docs
#     adminTokens:
#       paperclip:
#         secretEnv: LOOKIE_LINK_GRANT_ADMIN_TOKEN

# Optional mutable managed repositories. Every allow-root must already exist;
# newly registered repositories may only be created beneath one of them.
# managedRepos:
#   storePath: ~/.local/share/lookie-link/managed-repos.yaml
#   allowRoots:
#     - ~/shared-workspaces
#   adminTokens:
#     local_operator:
#       secretEnv: LOOKIE_LINK_MANAGED_REPO_ADMIN_TOKEN

# Optional immutable-revision publish area
# A slug can advance, but each numbered revision remains unchanged.
# publish:
#   enabled: true
#   areaPath: ~/.local/share/lookie-link/published
#   repoId: published
#   maxFiles: 100
#   maxFileBytes: 2097152
#   maxRevisionBytes: 10485760
#   maxMetadataBytes: 65536
#   maxRevisions: 20

# Custom themes
