# Lookie-Link Configuration
# ---------------------
# Copy this to ~/.config/lookie-link/lookie-link.yaml and customize for your setup.
# After editing, restart the server for changes to take effect.

# Server settings
server:
  port: 9876
  hostname: localhost  # e.g., my-server.local or my-host.tailnet.ts.net
  enableEditing: false # opt-in: set true only on trusted private networks

# Repository mappings
# Each key becomes a URL prefix: /view/<key>/<path>
# Values are absolute paths or ~-relative paths to local directories.
repositories:
  docs: ~/Documents/docs
  notes: ~/notes
  # project: ~/projects/my-project

# Custom themes
# Each theme needs dark and/or light variants.
# CSS property names use underscores (bg_elev → --bg-elev).
# themes:
