# First-party forms (Phase 1). Submissions are personal data and live in the
# sovereign personal repo, not application storage.
# Publishing (roadmap R1, 2026-09-23): immutable revisions of agent-authored bundles
# served under the virtual repo `published` (must not collide with a mapping).
# Area is per host; the store creates it. NOTE: with access.humanDefault: full any
# tailnet caller may publish — accepted for the private instance until the
# authentication workstream lands (owner-deferred).
publish:
  enabled: true
  areaPath: ~/.local/share/lookie-link/published
  repoId: published

forms:
  enabled: true
  templatesPath: ~/operations-chris-fonte/forms/templates
  destinations:
    default: ~/operations-chris-fonte/docs/health/fitness/gym-log/submissions
    gym-log: ~/operations-chris-fonte/docs/health/fitness/gym-log/submissions
    tanning: ~/operations-chris-fonte/docs/health/tanning/submissions
    medications: ~/operations-chris-fonte/docs/health/medications/submissions
  timezone: America/New_York
  # Browser mutations fail closed unless the exact origin is listed. This is the
  # UNION of every legitimate door to the fleet (origin validation is a
  # membership check; each replica must accept requests arriving via any of them).
  publicOrigins:
    - https://lookie.bobcat-tetra.ts.net
    - http://lookie.bobcat-tetra.ts.net
    - http://lookie.bobcat-tetra.ts.net:9876
    - http://lookie
    - http://us-east-ovh-vin-apps-1:9876
    - http://us-east-ovh-vin-apps-1.bobcat-tetra.ts.net:9876
    - https://us-east-ovh-vin-apps-1.bobcat-tetra.ts.net
    - http://mac-mini-2:9876
    - http://mac-mini-2.bobcat-tetra.ts.net:9876
    - http://localhost:9876
    - http://127.0.0.1:9876

