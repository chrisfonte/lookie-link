# ═══════════════════════════════════════════════════════════════════════════
# Lookie-Link — CANONICAL FLEET CONFIG (one file for every production instance)
# ═══════════════════════════════════════════════════════════════════════════
# Home:    ~/operations-system/config/lookie-link/lookie-link.yaml (Syncthing-synced)
# Deploy:  ~/operations-system/scripts/lookie-link/deploy-config.sh  (run ON the target host)
#          — splices access.grants.adminTokens from ~/.credentials/lookie-link-admin-tokens.yaml
#          — YAML-validates, backs up, atomically installs to ~/.config/lookie-link/lookie-link.yaml
#          — restarts the host's service (systemd on Linux, launchd on macOS) and post-checks
# Rule:    NEVER edit a host's ~/.config copy directly; edit THIS file and redeploy.
#          Per-host divergence is drift unless it is an explicitly-named dev variant
#          (LOOKIE_LINK_CONFIG env override is the escape hatch for those).
# Secrets: NEVER in this file or anywhere under a repo. adminTokens live only in
#          ~/.credentials/lookie-link-admin-tokens.yaml (0600) on each host.
# History: converged 2026-07-28 from the apps-1 + mac-mini-2 live configs
#          (session: ~/operations-system/docs/working-sessions/2026-07-28-lookie-config-convergence/).
#          Requires lookie-link >= 5de7469 (access.grants tilde expansion, issue #228).

# Server settings — hostname is cosmetic (startup log + link labels); the fleet's
# front door is the svc:lookie VIP, so every replica reports the shared name.
server:
  port: 9876
  hostname: lookie.bobcat-tetra.ts.net
  enableEditing: true
  enableAnnotations: true
  # FON-11792 — serve self-contained interactive HTML (NotebookLM flashcards/quiz)
  # verbatim through /raw/<repo>/<path>.html. Trust assumption documented in
  # lib/config.js (getRawHtmlEnabled). Safe on private Tailscale network where
  # all files under the mapped roots are author- or tool-vetted.
  enableRawHtml: true

# Repository mappings — each key becomes a URL prefix: /view/<key>/<path>.
# Union of the fleet: a repo missing on a given host just 404s per-request
# (code-verified; no startup failure), so hosts without clawd/hudu-cli/pii-scanner
# serve the rest unaffected.
repositories:
  operations: ~/operations
  operations-system: ~/operations-system
  operations-chris-fonte: ~/operations-chris-fonte
  operations-research: ~/operations-research
  operations-fontastic: ~/operations-fontastic
  operations-career: ~/operations-career
  operations-client-key-networks: ~/operations-client-key-networks
  operations-client-rfc-media: ~/operations-client-rfc-media
  operations-company-making-money: ~/operations-company-making-money
  operations-incubator: ~/operations-incubator
  operations-lookie-link: ~/operations-lookie-link
  operations-rdweb: ~/operations-rdweb
  operations-eartap: ~/operations-eartap
  operations-rdorch: ~/operations-rdorch
  operations-rdtap: ~/operations-rdtap
  # Product CODE clones (~/projects/*) are NOT mounted here: they contain .git and
  # may carry unsanitized host/client facts (2026-08-20 §46 review BLOCKER). Serve
  # planning satellites above; remount code only behind a .git deny / sanitized export.
  lookie-link: ~/projects/lookie-link
  music-scheduler: ~/projects/music-scheduler
  clawd: ~/clawd
  hudu-cli: ~/projects/fontastic/hudu-cli
  pii-scanner: ~/projects/markdown-pii-scanner

